# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=tu_token_de_acceso_permanente
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=elige_una_palabra_secreta_para_verificar_el_webhook
WHATSAPP_APP_SECRET=tu_app_secret_de_meta

# Número del admin/equipo del negocio en formato internacional sin "+" (ej. 5215512345678)
# Se le avisa de nuevas citas y desde aquí se pueden cancelar citas
ADMIN_WHATSAPP_NUMBER=5215512345678

# --- Google Calendar ---
# Ruta al JSON de la cuenta de servicio de Google Cloud
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
# Alternativa para hosts sin soporte de archivos secretos (ej. Railway):
# el contenido del JSON completo, codificado en base64, en una sola línea.
# Si se define, se escribe automáticamente en GOOGLE_SERVICE_ACCOUNT_KEY_FILE al arrancar.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_CALENDAR_ID=tu_calendario_id@group.calendar.google.com
GOOGLE_TIMEZONE=America/Mexico_City

# --- Claude (respuestas de preguntas libres) ---
ANTHROPIC_API_KEY=tu_api_key_de_anthropic

# --- Servidor ---
PORT=3000

# --- Negocio: horario de atención ---
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=20
APPOINTMENT_DURATION_MIN=45
